# ================================================================
#  Configuração do BibleRats — copie este arquivo para ".env.local"
#  e preencha com os dados do seu projeto Supabase.
#  (Supabase → Project Settings → API)
# ================================================================

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" / "publishable" (pode aparecer no navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" / "secret" — SECRETA! Nunca compartilhe nem coloque no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Domínio técnico antigo para logins sem e-mail (mantido por compatibilidade).
LOGIN_DOMINIO=bandinha.local

# ---- Primeiro administrador (usado só pelo comando: npm run seed:admin) ----
EDG_NOME=
EDG_EMAIL=
EDG_SENHA=
EDG_TELEFONE=
